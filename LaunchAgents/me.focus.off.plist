<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.focus.off</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>[ "$(id -un)" = working ] || /usr/bin/shortcuts run "Work Focus Off"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>

