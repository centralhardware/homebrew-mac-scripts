#!/bin/bash
# run-on-logout <user> <command> [args...]
# Waits in <user>'s session; launchd sends SIGTERM when that user logs out
# (also restart / shutdown), and then the command runs. Fast user switching does not trigger it.
[ "$(id -un)" = "$1" ] || exit 0   # loaded for every user
shift
cmd=("$@")

on_term() {
  trap '' TERM
  kill "$pid" 2>/dev/null
  "${cmd[@]}"
  rc=$?
  logger -t run-on-logout "${cmd[*]}: exit $rc"
  exit "$rc"
}
trap on_term TERM

while :; do
  sleep 86400 & pid=$!
  wait "$pid"
done
