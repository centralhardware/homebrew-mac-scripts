#!/bin/bash
# Self-updater: installs the newest GitHub release .pkg if it is newer than the installed one.
set -euo pipefail
REPO=centralhardware/mac-scripts
VER_FILE=/usr/local/share/mac-scripts/VERSION
TOKEN_FILE=/usr/local/etc/mac-scripts/token
log() { echo "$(date '+%F %T') $*"; }
auth=()
[ -r "$TOKEN_FILE" ] && auth=(-H "Authorization: Bearer $(cat "$TOKEN_FILE")")
json=$(/usr/bin/curl -fsSL "${auth[@]}" -H "Accept: application/vnd.github+json" \
  "https://api.github.com/repos/$REPO/releases/latest") || { log "release lookup failed"; exit 0; }
latest=$(echo "$json" | /usr/bin/plutil -extract tag_name raw - 2>/dev/null || true)
[ -z "$latest" ] && latest=$(echo "$json" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
cur=$(cat "$VER_FILE" 2>/dev/null || echo none)
[ "$latest" = "$cur" ] && exit 0
asset=$(echo "$json" | tr ',' '\n' | sed -n 's/.*"url": *"\(https:[^"]*releases\/assets\/[0-9]*\)".*/\1/p' | head -1)
[ -z "$asset" ] && { log "no asset in $latest"; exit 0; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
/usr/bin/curl -fsSL "${auth[@]}" -H "Accept: application/octet-stream" -o "$tmp/m.pkg" "$asset"
log "installing $latest (was $cur)"
/usr/sbin/installer -pkg "$tmp/m.pkg" -target /
