#!/bin/bash
# On every login or user switch, for any user: make the tunnels listed for that user in
# /etc/mac-scripts.conf the only active ones ("user: tunnel tunnel"; "*" = everyone else;
# nothing after the colon = no tunnels; user not listed = leave tunnels alone).
# A config edit is applied within 10 s.
# Tunnels changed by hand afterwards are left alone until the next switch.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
RUN=/var/run/wireguard
STATE=/var/run/wg-user-switch   # cleared at boot
mkdir -p "$STATE"

log() { echo "$(date '+%F %T') $*"; }

active() {
  for f in "$RUN"/*.name; do
    [ -e "$f" ] || continue
    p=$(basename "$f" .name); i=$(cat "$f")
    s="$RUN/$i.sock"
    d=$(( $(stat -f %m "$s" 2>/dev/null || echo 0) - $(stat -f %m "$f") ))
    if [ -S "$s" ] && [ $d -gt -2 ] && [ $d -lt 2 ]; then
      echo "$p"
    else
      rm -f "$f"   # stale: never touch the sock, it may belong to another tunnel
    fi
  done
}

# Make exactly the given tunnels active (none = all off).
set_active() {
  live=$(active | xargs)
  for p in $live; do
    case " $* " in *" $p "*) ;; *) log "down $p"; wg-quick down "$p" ;; esac
  done
  for p in "$@"; do
    case " $live " in *" $p "*) ;; *) log "up $p"; wg-quick up "$p" ;; esac
  done
}

user=$(stat -f %Su /dev/console)
case "$user" in
  ""|root|loginwindow|_mbsetupuser) rm -f "$STATE/user"; exit 0 ;;   # login screen: the next login counts as a switch
esac

CONF=${CONF:-/etc/mac-scripts.conf}
# The user's own line wins over "*"; exit 1 = neither is there.
line=$(awk -F: -v u="$user" '
  { sub(/#.*/, ""); k = $1; gsub(/[ \t]/, "", k) }
  NF < 2 { next }
  k == u   { own = $2; o = 1 }
  k == "*" { any = $2; a = 1 }
  END { if (o) print own; else if (a) print any; else exit 1 }' "$CONF") || exit 0
want=$(echo "$line" | tr -s ' \t' '\n' | grep . | sort -u | xargs)

# no user switch and no config change: nothing to do
[ "$user: $want" = "$(cat "$STATE/user" 2>/dev/null)" ] && exit 0

log "$user in front, switching to: ${want:-no tunnels}"
set_active $want
# Remember the switch only once it fully worked, so a failure is retried on the next run.
[ "$(active | sort | xargs)" = "$want" ] && echo "$user: $want" > "$STATE/user"
exit 0
