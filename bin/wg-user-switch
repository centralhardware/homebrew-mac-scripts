#!/bin/bash
# On every login or user switch, for any user: make wg1 the only active tunnel.
# Tunnels changed by hand afterwards are left alone until the next switch.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
RUN=/var/run/wireguard
STATE=/var/run/wg-user-switch   # cleared at boot
mkdir -p "$STATE"

log() { echo "$(date '+%F %T') $*"; }

active() {
  for f in "$RUN"/*.name; do
    [ -e "$f" ] || continue
    p=$(basename "$f" .name); i=$(cat "$f")
    s="$RUN/$i.sock"
    d=$(( $(stat -f %m "$s" 2>/dev/null || echo 0) - $(stat -f %m "$f") ))
    if [ -S "$s" ] && [ $d -gt -2 ] && [ $d -lt 2 ]; then
      echo "$p"
    else
      rm -f "$f"   # stale: never touch the sock, it may belong to another tunnel
    fi
  done
}

# Make exactly the given tunnels active (none = all off).
set_active() {
  live=$(active)
  for p in $live; do
    case " $* " in *" $p "*) ;; *) log "down $p"; wg-quick down "$p" ;; esac
  done
  for p in "$@"; do
    case " $live " in *" $p "*) ;; *) log "up $p"; wg-quick up "$p" ;; esac
  done
}

user=$(stat -f %Su /dev/console)
case "$user" in
  ""|root|loginwindow|_mbsetupuser) rm -f "$STATE/user"; exit 0 ;;   # login screen: the next login counts as a switch
esac

[ "$user" = "$(cat "$STATE/user" 2>/dev/null)" ] && exit 0   # no user switch, nothing to do

log "$user in front, switching to wg1"
set_active wg1
# Remember the user only once wg1 is the only tunnel, so a failure is retried on the next run.
[ "$(active)" = wg1 ] && echo "$user" > "$STATE/user"
exit 0
