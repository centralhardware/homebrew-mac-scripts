#!/bin/bash
# Work Focus follows the session of `working`:
#   working logs in       -> "Work Focus" on
#   working logs out      -> "Work Focus Off" (launchd sends SIGTERM at logout / restart / shutdown)
#   anyone else logs in   -> "Work Focus Off" (fallback: Focus syncs over the Apple ID, so this
#                            catches a logout where the off above didn't get through)
# Fast user switching is neither a login nor a logout.
LOG="$HOME/Library/Logs/work-focus.log"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; logger -t work-focus "$*"; }

# Run a shortcut in its own process group so launchd's teardown of this job at logout
# doesn't take it down with us; its output goes to the log so a failure says why.
run() {
  /usr/bin/perl -e 'setpgrp(0,0); exec @ARGV' /usr/bin/shortcuts run "$1" >> "$LOG" 2>&1 &
  pid=$!
  wait "$pid"; rc=$?
  log "$1: exit $rc"
  return $rc
}

if [ "$(id -un)" != working ]; then
  run "Work Focus Off"
  exit 0
fi

focus_off() {
  trap '' TERM
  kill "$pid" 2>/dev/null   # the "on" shortcut or the sleep
  log "logout: turning Work Focus off"
  for try in 1 2 3; do
    run "Work Focus Off" && exit 0
    sleep 1
  done
  exit 1
}
trap focus_off TERM

run "Work Focus"

while :; do
  sleep 86400 & pid=$!
  wait "$pid"
done
